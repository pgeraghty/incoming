# Docker image to run (publish this to Docker Hub).
INCOMING_IMAGE=pgeraghty/incoming-demo:latest

# Public host used by senders and TLS certificate.
INCOMING_HOST=mail.example.com
INCOMING_DOMAIN=example.com

# Host bind and container SMTP listener.
SMTP_HOST_BIND=0.0.0.0
SMTP_HOST_PORT=25
SMTP_PORT=2525

# TLS mode: disabled | optional | required | implicit
SMTP_TLS_MODE=required

# Optional overrides. If unset, Incoming derives:
# /var/lib/lego/certificates/${INCOMING_HOST}.crt and .key
# SMTP_TLS_CERTFILE=/var/lib/lego/certificates/mail.example.com.crt
# SMTP_TLS_KEYFILE=/var/lib/lego/certificates/mail.example.com.key
TLS_WAIT_TIMEOUT_SECONDS=300

# Queue and session settings.
QUEUE_PATH=/var/lib/incoming
QUEUE_FSYNC=true
QUEUE_MAX_DEPTH=100000
QUEUE_CLEANUP_INTERVAL_MS=60000
QUEUE_DEAD_TTL_SECONDS=604800
SESSION_MAX_MESSAGE_SIZE=10485760
SESSION_MAX_RECIPIENTS=100
SESSION_MAX_COMMANDS=1000
SESSION_MAX_ERRORS=10
LISTENER_MAX_CONNECTIONS=1000
LISTENER_MAX_CONNECTIONS_PER_IP=10
LISTENER_NUM_ACCEPTORS=10

# ACME (lego DNS challenge). Required when using profile "acme".
ACME_EMAIL=postmaster@example.com
ACME_DNS_PROVIDER=cloudflare
ACME_RENEW_DAYS=30
ACME_RENEW_INTERVAL_SECONDS=43200

# Example provider credential for Cloudflare DNS-01.
# Use a scoped API token with DNS edit permissions for your zone.
CLOUDFLARE_DNS_API_TOKEN=replace_me
